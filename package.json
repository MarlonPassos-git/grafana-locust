{
  "name": "grafana-locust",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "webpack --mode production && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@grafana/data": "13.2.5",
    "@grafana/runtime": "13.2.5",
    "@grafana/ui": "13.2.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "jsdom": "27.1.0",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "vitest": "4.0.8",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1"
  }
}
